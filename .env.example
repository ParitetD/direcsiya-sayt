# Скопируй этот файл в .env и заполни значения
PORT=3000

# Обязательно: секрет для JWT-токенов админки (любая длинная случайная строка)
JWT_SECRET=replace-with-a-long-random-secret

# Пароль по умолчанию при первом запуске (если admin.json ещё не существует)
ADMIN_DEFAULT_PASSWORD=admin123

# Опционально: разрешить CORS с другого домена (например при отдельном фронтенде)
# CORS_ORIGIN=https://yourdomain.com

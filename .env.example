# ── Required ────────────────────────────────────────────────
# JWT secret for token signing — use at least 32 random characters
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars

# ── Optional ─────────────────────────────────────────────────
# Admin password on first run (default: admin123 — CHANGE THIS)
ADMIN_DEFAULT_PASSWORD=admin123

# Server port (default: 3000)
# PORT=3000

# Restrict CORS to your production domain (default: * — insecure for production)
# CORS_ORIGIN=https://natsport.kg
